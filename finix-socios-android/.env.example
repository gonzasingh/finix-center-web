# La app ya se conecta sola a la API real de FINIX (http://nuevo.mine.nu/admcloud-api/api/, empresa FINIX): NO necesitás completar nada para compilar.
# Estas variables son opcionales y solo sirven si algún día cambia el servidor.
# Copiá este archivo como .env.production.local para usarlas.

# Dirección base de la API (debe terminar en /api/). Si pasa a https, además borrá el bloque <domain-config> de
# android/app/src/main/res/xml/network_security_config.xml. Si cambia a otro dominio http, reemplazá allí el dominio.
# VITE_API_BASE_URL=https://nuevo.mine.nu/admcloud-api/api/

# Código de empresa con el que se inicia sesión (en la app anterior es FINIX).
# VITE_EMPRESA_CODIGO=FINIX
