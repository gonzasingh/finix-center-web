# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Firebase
# (Firebase Console > Configuración del proyecto > Tus apps > App web).
# Si NO completás estas variables, el sitio funciona en MODO DEMO con datos de ejemplo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominio "técnico" que se usa para convertir el DNI de un socio en un usuario de Firebase Auth.
# Ej: DNI 38492615 -> 38492615@socios.finixcenter.app  (no es un mail real, no recibe correos)
VITE_SOCIO_EMAIL_DOMAIN=socios.finixcenter.app
