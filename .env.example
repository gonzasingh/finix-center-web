# El sitio ya se conecta solo a la API real de FINIX (AdmCloud, empresa FINIX): NO necesitás completar nada para publicarlo.
# Estas variables son opcionales y solo sirven si algún día cambia el servidor.
# Copiá este archivo como .env.local para usarlas.

# Dirección base de la API (debe terminar en /api/). Por defecto el sitio usa su propia ruta /admcloud-api/api/, que el hosting
# (vercel.json) y el proxy de Vite (npm run dev:real) reenvían a https://nuevo.mine.nu/admcloud-api/api/. El servidor no habilita CORS,
# así que solo definí esta variable con una dirección completa si el servidor llega a habilitar CORS para el dominio del sitio.
# VITE_API_BASE_URL=https://nuevo.mine.nu/admcloud-api/api/

# Código de empresa con el que se inicia sesión.
# VITE_EMPRESA_CODIGO=FINIX

# Dirección del novedades.json del carrusel "Novedades para vos" (ver LEEME-NOVEDADES.md). Vacío = usa solo el kit incluido en public/novedades.
# VITE_NEWS_URL=https://gonzasingh.github.io/finix-novedades/novedades.json

# ---- Panel de colaboradores ("Soy colaborador") ----
# Sin estas variables el panel funciona con datos de EJEMPLO guardados en el navegador (colaborador@finixcenter.com / Finix2026!).
# Con ellas usa Firebase (Authentication + Firestore): ver README. Los socios no usan Firebase, usan la API de FINIX.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
